* {
	-unity-font-definition: url(/Assets/Fonts/High_Birth.ttf);
}

:root {
	display: none;
}

.main-container {
	width: 100%;
	height: 100%;
	padding-left: 3%;
	flex-direction: column;
}

.title {
	color: white;
	margin-top: 1%;
	font-size: 135px;
	-unity-font-style: bold;
}

.buttons-container {
	align-items: flex-end;
	width: 100%;
	padding-right: 2%;
	height: auto;
	padding-top: 10%;
	flex-grow: 1;
}

Button {
	padding: 3%;
	font-size: 50px;
	width: 33%;
	height: 16%;
	margin-bottom: 30px;
}

Button:focus {
	border-color: transparent;
}

.version-label {
	font-size: 35px;
	color: navajowhite;
	padding-right: 4px;
	align-self: flex-end;
	-unity-font-style: bold;
}
