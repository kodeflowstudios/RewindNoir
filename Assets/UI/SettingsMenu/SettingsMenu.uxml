<ui:UXML 
  xmlns:ui="UnityEngine.UIElements" 
  xmlns:uie="UnityEditor.UIElements" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  engine="UnityEngine.UIElements" 
  editor="UnityEditor.UIElements" 
  noNamespaceSchemaLocation="/UIElementsSchema/UIElements.xsd" 
  editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SettingsMenu/SettingsMenu.uss"/>
    <ui:VisualElement class="pause-container" name="Pause">
        <ui:Label text="Paused" class="title" name="label_settings" style="width: 100%; -unity-text-align: middle-center;"/>
		<ui:Button text="Resume" name="button_resume"/>
		<ui:Button text="Settings" name="button_settings"/>
		<ui:Button text="Quit" name="button_quit"/>
    </ui:VisualElement>
    <ui:VisualElement class="settings-container" name="Settings">
        <ui:Label text="Settings" class="title" name="label_settings"/>
        <ui:VisualElement class="settings-items-container" name="settings_items_container">
			<ui:Slider label="Sensitivity" name="slider_sens" low-value="0.2" high-value="10"/>
			<ui:DropdownField label="Language" name="dropdown_lang"/>
        </ui:VisualElement>
		<ui:Button text="Back" name="button_back"/>
    </ui:VisualElement>
</ui:UXML>
