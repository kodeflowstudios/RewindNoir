<ui:UXML 
	xmlns:ui="UnityEngine.UIElements" 
	xmlns:uie="UnityEditor.UIElements" 
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	engine="UnityEngine.UIElements" 
	editor="UnityEditor.UIElements" 
	noNamespaceSchemaLocation="/UIElementsSchema/UIElements.xsd" 
	editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SplashScreen/SplashScreen.uss"/>
    <ui:VisualElement class="main-container">
        <ui:VisualElement name="container_splash" class="splash-container" style="">
            <ui:VisualElement name="Logo"/>
            <ui:Label text="KodeFlow Studios"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
