.main-container {
	flex-grow: 1; 
	flex-direction: row; 
	background-color: rgb(6, 6, 6); 
	opacity: 1; 
	display: flex; 
	-unity-text-outline-color: rgb(0, 0, 0);
}

.splash-container {
	flex-grow: 1; 
	flex-direction: row; 
	background-color: rgb(6, 6, 6); 
	align-self: center; 
	align-items: center; 
	justify-content: center; 
	opacity: 0;
}

#Logo {
	flex-grow: 0;
	background-image: url("/Assets/UI/SplashScreen/Resources/LogoTransparent.png"); 
	background-color: rgba(255, 255, 255, 0);
	background-size: 300px 300px; 
	flex-shrink: 0; 
	width: 300px; 
	height: 300px;
}

Label {
	-unity-text-align: middle-center; 
	flex-shrink: 1; 
	flex-grow: 0; 
	-unity-font-definition: url("/Assets/UI/SplashScreen/Resources/Margaret-Bold.otf"); 
	font-size: 86px; 
	color: rgb(255, 255, 255); 
	margin-left: 30px;
}
