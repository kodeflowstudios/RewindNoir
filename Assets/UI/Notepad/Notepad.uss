* {
	flex-shrink: 1;
	-unity-font-style: bold;
	-unity-font-definition: url(/Assets/Fonts/Kalam-Regular.ttf);
}

:root {
	display: none;
}

.frame {
	width: 700px;
	height: 1200px;
	flex-direction: column;
	padding: 125px 65px 52px 65px;
	align-self: center;
	background-image: url(/Assets/Images/hobgoblin_tech-paper-7098788.png);
}

.header {
	font-size: 30px;
}

.label-name {
	margin-top: 10px;
	font-size: 35px;
}

.label-details {
	font-size: 30px;
	white-space: normal;
}

.footer {
	flex-grow: 0;
	flex-shrink: 0;
	margin-top: auto;
	justify-content: space-between;
	flex-direction: row;
}

#page_two {
	display: none;
}

.current-page {
	margin: auto 0;
	font-size: 35px;
	-unity-font-style: normal;
	-unity-font-definition: url(/Assets/Fonts/BebasNeue-Regular.ttf);
}

.button-prev, .button-next {
	font-size: 60px;
	color: #212121;
	background-color: transparent;
	border-width: 0;
	flex-grow: 1;
}

.button-prev:hover, .button-next:hover {
	color: #636363;
}

.button-prev:active, .button-next:active {
	color: #3a3a3a;
}

.button-prev:disabled, .button-next:disabled {
	color: #b7b7b7;
}

.button-prev {
	-unity-text-align: middle-left;
}

.button-next {
	-unity-text-align: middle-right;
}
