.main-container {
	padding-left: 3%;
	background-color: grey;
	width: 100%;
	height: 100%;
	flex-direction: column;
}

.title {
	color: darkred;
	font-size: 90px;
	-unity-font-style: bold;
}

.buttons-container {
	align-items: flex-start;
	width: 100%;
	height: auto;
	padding-top: 5%;
	flex-grow: 1;
}

Button {
	font-size: 55px;
	width: 40%;
	height: 25%;
	margin-bottom: 30px;
}

Button:focus {
	border-color: transparent;
}

.version-label {
	font-size: 20px;
	-unity-font-style: bold;
}
