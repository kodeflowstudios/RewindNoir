<ui:UXML 
  xmlns:ui="UnityEngine.UIElements" 
  xmlns:uie="UnityEditor.UIElements" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  engine="UnityEngine.UIElements" 
  editor="UnityEditor.UIElements" 
  noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" 
  editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/MainMenu.uss"/>
    <ui:VisualElement class="main-container" name="Main">
        <ui:Label text="Rewind Noir" class="title" name="title"/>
        <ui:VisualElement class="buttons_container">
            <ui:Button text="Play" name="play"/>
            <ui:Button text="Quit" name="quit"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
