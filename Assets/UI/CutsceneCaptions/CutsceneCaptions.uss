:root {
    padding: 0;
    margin: 0;
    display: flex;
}

#mainContainer {
	width: 100%;
	height: 100%;
    flex-grow: 1;
	flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 20px;
}

#label_captions {
    margin-left: 1%;
    color: rgb(227, 227, 227);
    font-size: 50px;
    white-space: normal;
	-unity-font-definition: url(/Assets/Fonts/Bellerose.ttf);
}
